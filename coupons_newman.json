{
  "info": {
    "name": "Coupons API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Coupons List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains coupons array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"coupons\");",
              "    pm.expect(jsonData.coupons).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4566/restapis/t0kturrjsp/prod/_user_request_/coupons_poc",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "4566",
          "path": [
            "restapis",
            "t0kturrjsp",
            "prod",
            "_user_request_",
            "coupons_poc"
          ]
        }
      },
      "response": []
    }
  ]
